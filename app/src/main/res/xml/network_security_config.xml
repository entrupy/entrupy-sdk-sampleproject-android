<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds also trust user-installed CAs, so traffic can be inspected through a
    proxy such as Proxyman or Charles. Release builds ignore debug-overrides.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
